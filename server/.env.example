PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
APP_SCOPE=kingmops

# Firebase Admin. Use escaped newlines in FIREBASE_PRIVATE_KEY or wrap the value in quotes.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Optional first admin seeding. Run npm run seed:admin after filling Firebase Admin values.
INITIAL_ADMIN_EMAIL=admin@kingbrandmops.in
INITIAL_ADMIN_PASSWORD=change_this_password
INITIAL_ADMIN_NAME=King Mops Admin
INITIAL_ADMIN_PHONE=9876543210

# Razorpay. Keep the secret server-side only.
RAZORPAY_KEY_ID=rzp_test_your_public_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=optional_webhook_secret

# Demo mode is automatically enabled when Firebase/Razorpay secrets are missing.
DEMO_MODE=true
