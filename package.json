    "preview": "vite preview --configLoader native --host 0.0.0.0",
    "check": "npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^11.2.0",
    "firebase-admin": "^13.0.2",
    "helmet": "^8.0.0",
    "jspdf": "^2.5.2",
    "lucide-react": "^0.468.0",
    "razorpay": "^2.9.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "recharts": "^2.15.0",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
