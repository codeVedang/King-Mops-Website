{
  "name": "kingmops-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite --configLoader native --host 0.0.0.0",
    "server": "node server/src/index.js",
    "seed:admin": "node server/src/scripts/seedAdmin.js",
